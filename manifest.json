{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.7.2",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://www.perplexity.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://www.perplexity.ai/*"
      ]
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chat Distiller",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "prompt-constants.js",
        "i18n.js",
        "src/core/protocol.js",
        "src/core/dom-utils.js",
        "src/core/card-ui.js",
        "src/core/editor.js",
        "src/core/adapter-registry.js",
        "src/site/chatgpt.js",
        "src/core/engine.js",
        "src/content-entry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "prompt-constants.js",
        "i18n.js",
        "src/core/protocol.js",
        "src/core/dom-utils.js",
        "src/core/card-ui.js",
        "src/core/editor.js",
        "src/core/adapter-registry.js",
        "src/site/deepseek.js",
        "src/core/engine.js",
        "src/content-entry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "prompt-constants.js",
        "i18n.js",
        "src/core/protocol.js",
        "src/core/dom-utils.js",
        "src/core/card-ui.js",
        "src/core/editor.js",
        "src/core/adapter-registry.js",
        "src/site/gemini.js",
        "src/core/engine.js",
        "src/content-entry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": [
        "prompt-constants.js",
        "i18n.js",
        "src/core/protocol.js",
        "src/core/dom-utils.js",
        "src/core/card-ui.js",
        "src/core/editor.js",
        "src/core/adapter-registry.js",
        "src/site/doubao.js",
        "src/core/engine.js",
        "src/content-entry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "prompt-constants.js",
        "i18n.js",
        "src/core/protocol.js",
        "src/core/dom-utils.js",
        "src/core/card-ui.js",
        "src/core/editor.js",
        "src/core/adapter-registry.js",
        "src/site/perplexity.js",
        "src/core/engine.js",
        "src/content-entry.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
